{
  "environment": "development",
  "port": 3000,
  "dataDir": "./data",
  "logLevel": "info",
  "corsOrigins": ["http://localhost:5173"],
  "passwordMinLength": 12,
  "maxFailedLoginAttempts": 5,
  "lockoutDurationMinutes": 15,
  "accessTokenTtlMinutes": 15,
  "refreshTokenTtlDays": 7,
  "authRateLimitWindowMs": 900000,
  "authRateLimitMax": 20,
  "allowRefreshTokenInBody": false,
  "enrolmentReRequestCooldownHours": 24,
  "maxUploadSizeMb": 10,
  "maxDocxExpandedSizeMb": 50,
  "chunkSizeTokens": 512,
  "chunkOverlapTokens": 100,
  "chunkCacheMaxDocuments": 100,
  "mistralEmbeddingModel": "mistral-embed",
  "mistralEmbeddingDimension": 1024
}
