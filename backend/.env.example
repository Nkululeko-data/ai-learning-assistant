NODE_ENV=development
PORT=3000
DATA_DIR=./data
# Use the pooled Neon connection URL with sslmode=require.
DATABASE_URL=
MONGODB_URI=
MONGODB_DB_NAME=
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173

# Neon PostgreSQL and MongoDB are required for runtime and migration scripts.
DATABASE_URL=
MONGODB_URI=
MONGODB_DATABASE=

PASSWORD_MIN_LENGTH=12
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
ALLOW_REFRESH_TOKEN_IN_BODY=false
ENROLMENT_RE_REQUEST_COOLDOWN_HOURS=24
MAX_UPLOAD_SIZE_MB=10
MAX_DOCX_EXPANDED_SIZE_MB=50
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=100
CHUNK_CACHE_MAX_DOCUMENTS=100
INCEPTION_MODEL=mercury-3
GROQ_MODEL=openai/gpt-oss-20b
CHAT_MIN_SIMILARITY=0.3
CHAT_MIN_CHUNKS=1
CHAT_MIN_CITATIONS=1
CHAT_TOP_K=8
CHAT_MAX_CONTEXT_TOKENS=6000
CHAT_HISTORY_WINDOW=8
CHAT_HISTORY_TOKEN_BUDGET=2000
CHAT_NODE_TIMEOUT_MS=60000
CHAT_MAX_COMPLETION_TOKENS=1200
CHAT_PROMPT_VERSION=v1
LEARNING_PROMPT_VERSION=v1
INSIGHT_MIN_COHORT_SIZE=3
INSIGHT_PERIOD_DAYS=7
GAP_REPORTS_MAX_PER_COURSE=10
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_MAX=10
CHAT_DAILY_REQUEST_LIMIT=100
CHAT_DAILY_TOKEN_LIMIT=100000

# Generate unique values locally; do not use these placeholder values.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

INCEPTION_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
