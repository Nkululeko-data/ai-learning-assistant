{
  "name": "ai-learning-assistant-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend for the AI Learning Assistant",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "db:migrate": "tsx scripts/migrate-database-schema.ts",
    "db:import-legacy": "tsx scripts/migrate-databases.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "eval:offline": "jest --runInBand tests/ai-eval/offline-eval.test.ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.7.5",
    "argon2": "0.45.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "file-type": "^22.3.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mammoth": "^1.13.0",
    "mongodb": "^7.9.1",
    "multer": "^2.5.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "swagger-ui-express": "^5.0.1",
    "yauzl": "^3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yauzl": "^3.4.0",
    "jest": "30.5.2",
    "pino-pretty": "^13.2.0",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
